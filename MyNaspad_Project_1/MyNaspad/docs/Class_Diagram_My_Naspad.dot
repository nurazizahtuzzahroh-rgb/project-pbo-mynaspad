digraph G {
  rankdir=TB; nodesep=0.45; ranksep=0.85; splines=ortho; bgcolor="white";
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#333333"];
  FormUtama [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF2FB"><TR><TD><B>FormUtama</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- btnPesan: JButton</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- btnKeluar: JButton</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- lblStatus: JLabel</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- initComponents(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- cekKoneksi(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- btnPesanActionPerformed(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- btnKeluarActionPerformed(): void</TD></TR></TABLE>>];
  FormPesan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF2FB"><TR><TD><B>FormPesan</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- menuDAO: MenuDAO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pesananDAO: PesananDAO</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- pesanan: Pesanan</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- cmbMenu: JComboBox&lt;MenuNaspad&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tblKeranjang: JTable</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- muatMenu(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tampilkanDetailMenu(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- refreshKeranjang(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- hitungKembalian(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- siapkanKomponen(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- btnTambahActionPerformed(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- btnHapusActionPerformed(): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- btnProsesActionPerformed(): void</TD></TR></TABLE>>];
  JFrame [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F2F2F2"><TR><TD><FONT POINT-SIZE="10">javax.swing</FONT></TD></TR><TR><TD><B>JFrame</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD> </TD></TR></TABLE>>];
  MenuDAO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4E0"><TR><TD><B>MenuDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ buatMenu(kategori, kode, nama, harga, stok): MenuNaspad</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getSemuaMenu(): List&lt;MenuNaspad&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getByKode(kode: String): MenuNaspad</TD></TR></TABLE>>];
  PesananDAO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4E0"><TR><TD><B>PesananDAO</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ simpan(pesanan: Pesanan, bayar: double): int</TD></TR></TABLE>>];
  Koneksi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFF4E0"><TR><TD><B>Koneksi</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- URL: String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- USER: String</U></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>- PASSWORD: String</U></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><U>+ getKoneksi(): Connection</U></TD></TR></TABLE>>];
  Pesanan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F5E9"><TR><TD><B>Pesanan</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- namaPelanggan: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- tanggal: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- daftarItem: List&lt;ItemPesanan&gt;</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setNamaPelanggan(nama: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getDaftarItem(): List&lt;ItemPesanan&gt;</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tambahItem(menu: MenuNaspad, jumlah: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hapusItem(index: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getJumlahMenu(kode: String): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hitungTotal(): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hitungKembalian(bayar: double): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ buatStruk(id: int, bayar: double): String</TD></TR></TABLE>>];
  ItemPesanan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E8F5E9"><TR><TD><B>ItemPesanan</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- menu: MenuNaspad</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- jumlah: int</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getMenu(): MenuNaspad</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getJumlah(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ tambahJumlah(tambahan: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getSubtotal(): double</TD></TR></TABLE>>];
  KetersediaanMenu [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F3E5F5"><TR><TD><FONT POINT-SIZE="10">«interface»</FONT></TD></TR><TR><TD><B>KetersediaanMenu</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ stokMasuk(jumlah: int): void</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ stokKeluar(jumlah: int): boolean</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ isTersedia(jumlah: int): boolean</I></TD></TR></TABLE>>];
  MenuNaspad [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDECEA"><TR><TD><FONT POINT-SIZE="10">«abstract»</FONT></TD></TR><TR><TD><B><I>MenuNaspad</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- kodeMenu: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- namaMenu: String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- harga: double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- stok: int</TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getKodeMenu(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getNamaMenu(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getHarga(): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getStok(): int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setNamaMenu(namaMenu: String): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setHarga(harga: double): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ setStok(stok: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ stokMasuk(jumlah: int): void</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ stokKeluar(jumlah: int): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isTersedia(jumlah: int): boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ hitungHarga(jumlah: int): double</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getKategori(): String</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getSatuan(): String</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ getInfoMenu(): String</I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"># hargaDasar(jumlah: int): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ toString(): String</TD></TR></TABLE>>];
  LaukPauk [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDECEA"><TR><TD><B>LaukPauk</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hitungHarga(jumlah: int): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getKategori(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getSatuan(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getInfoMenu(): String</TD></TR></TABLE>>];
  Minuman [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDECEA"><TR><TD><B>Minuman</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hitungHarga(jumlah: int): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getKategori(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getSatuan(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getInfoMenu(): String</TD></TR></TABLE>>];
  Pelengkap [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FDECEA"><TR><TD><B>Pelengkap</B></TD></TR><HR/><TR><TD> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ hitungHarga(jumlah: int): double</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getKategori(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getSatuan(): String</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getInfoMenu(): String</TD></TR></TABLE>>];
  JFrame -> FormUtama [dir=back, arrowtail=empty, style=solid];
  JFrame -> FormPesan [dir=back, arrowtail=empty, style=solid];
  FormUtama -> FormPesan [style=dashed, arrowhead=vee, xlabel="«opens»"];
  FormPesan -> MenuDAO [style=dashed, arrowhead=vee];
  FormPesan -> PesananDAO [style=dashed, arrowhead=vee];
  FormPesan -> Pesanan [arrowhead=vee, headlabel="1", taillabel=" ", xlabel="pesanan"];
  MenuDAO -> Koneksi [style=dashed, arrowhead=vee];
  PesananDAO -> Koneksi [style=dashed, arrowhead=vee];
  PesananDAO -> Pesanan [style=dashed, arrowhead=vee, xlabel="«uses»"];
  MenuDAO -> MenuNaspad [style=dashed, arrowhead=vee, xlabel="«creates»"];
  Pesanan -> ItemPesanan [dir=both, arrowtail=diamond, arrowhead=none, headlabel="0..*", xlabel="daftarItem"];
  ItemPesanan -> MenuNaspad [arrowhead=vee, headlabel="1", xlabel="menu"];
  KetersediaanMenu -> MenuNaspad [dir=back, arrowtail=empty, style=dashed];
  MenuNaspad -> LaukPauk [dir=back, arrowtail=empty, style=solid];
  MenuNaspad -> Minuman [dir=back, arrowtail=empty, style=solid];
  MenuNaspad -> Pelengkap [dir=back, arrowtail=empty, style=solid];
}